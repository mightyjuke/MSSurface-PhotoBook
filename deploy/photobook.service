[Unit]
Description=Local digital photo frame server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=photobook
Group=photobook
EnvironmentFile=-/etc/default/photobook
ExecStart=/usr/local/bin/photobook
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/photobook

[Install]
WantedBy=multi-user.target
